# Copy this file to .env on the client VPS. Do not publish .env.
SITE_ID=demo
DOMAIN=your-domain.ru
PUBLIC_ORIGIN=https://your-domain.ru
NODE_ENV=production
DEMO_MODE=false
HOST=0.0.0.0
PORT=3100
DATA_DIR=/data
TZ=Europe/Moscow
# Administrator access was configured once in Template Studio.
# Optional per-site Telegram integration; never put real values in this ZIP.
TELEGRAM_DEMO_TOKEN=
TELEGRAM_DEMO_OWNER_CHAT=
TELEGRAM_DEMO_USERNAME=
TELEGRAM_DEMO_WEBHOOK_SECRET=
TG_PERSONAL_DATA_APPROVED=false
